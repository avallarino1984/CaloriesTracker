@* Cloud sync: sign in with an emailed code, show status, sign out. *@
@inherits StateComponent

<section class="card">
    <h2>Synchronisation</h2>

    @if (!State.CloudAvailable)
    {
        <p class="muted small">Synchro non configurée (Supabase absent de appsettings.json). Les données restent sur cet appareil.</p>
    }
    else if (State.CloudEmail is { } email)
    {
        <p class="small">
            <span class="sync-dot @StatusCss"></span>
            @StatusLabel · <strong>@email</strong>
        </p>
        @if (State.SyncError is { } error)
        {
            <p class="err small">@error</p>
        }
        <div class="row-gap">
            <button class="btn" disabled="@(State.Sync == SyncStatus.Syncing)" @onclick="() => State.SyncAsync()">Synchroniser</button>
            <button class="btn" @onclick="SignOut">Se déconnecter</button>
        </div>
    }
    else if (!_useEmailLink)
    {
        <p class="muted small">Connecte-toi pour retrouver les mêmes données sur l'iPhone et l'ordi.</p>
        <label>Courriel<input type="email" autocomplete="username" inputmode="email" @bind="_email" @bind:event="oninput" /></label>
        <label>Mot de passe<input type="password" autocomplete="current-password" @bind="_password" @bind:event="oninput" /></label>
        <button class="btn primary full" disabled="@(_busy || !_email.Contains('@') || _password.Length == 0)" @onclick="SignInWithPassword">Se connecter</button>
        <button class="link" @onclick="() => _useEmailLink = true">Recevoir plutôt un lien par courriel</button>
    }
    else if (!_codeSent)
    {
        <p class="muted small">Tu recevras un courriel de connexion (2 courriels par heure au maximum).</p>
        <label>Courriel<input type="email" autocomplete="email" inputmode="email" @bind="_email" @bind:event="oninput" /></label>
        <button class="btn primary full" disabled="@(_busy || !_email.Contains('@'))" @onclick="SendCode">Recevoir le courriel</button>
        <button class="link" @onclick="() => _useEmailLink = false">Utiliser un mot de passe</button>
    }
    else
    {
        <p class="muted small">Courriel envoyé à <strong>@_email</strong> (vérifie aussi les indésirables).</p>
        <p class="small">Colle ici <strong>le code</strong> s'il y en a un, sinon <strong>le lien</strong> du courriel, copié sans l'ouvrir.
            Si tu l'as déjà ouvert, colle l'adresse de la page où il t'a mené.</p>
        <label>Code ou lien<textarea rows="3" autocomplete="one-time-code" @bind="_code" @bind:event="oninput"></textarea></label>
        <button class="btn primary full" disabled="@(_busy || _code.Trim().Length < 6)" @onclick="Verify">Se connecter</button>
        <button class="link" @onclick="() => _codeSent = false">Changer de courriel</button>
    }

    @if (_message is not null)
    {
        <p class="err small">@_message</p>
    }
</section>

@code {
    private string _email = "";
    private string _code = "";
    private string _password = "";
    private bool _useEmailLink;
    private bool _codeSent;
    private bool _busy;
    private string? _message;

    private string StatusLabel => State.Sync switch
    {
        SyncStatus.Synced => State.LastSyncedAt is { } at ? $"Synchronisé à {at:HH:mm}" : "Synchronisé",
        SyncStatus.Syncing => "Synchronisation…",
        SyncStatus.Pending => "En attente (hors ligne ?)",
        _ => "Local seulement",
    };

    private string StatusCss => State.Sync switch
    {
        SyncStatus.Synced => "ok",
        SyncStatus.Pending => "warn",
        _ => "",
    };

    private async Task SendCode() => await Run(async () =>
    {
        await State.SendCodeAsync(_email);
        _codeSent = true;
        _code = "";
    });

    private async Task Verify() => await Run(async () =>
    {
        await State.SignInAsync(_email, _code);
        _codeSent = false;
    });

    private async Task SignInWithPassword() => await Run(async () =>
    {
        await State.SignInWithPasswordAsync(_email, _password);
        _password = "";
    });

    private async Task SignOut() => await Run(State.SignOutAsync);

    // Runs a cloud action with a busy flag and a user-facing error message.
    private async Task Run(Func<Task> action)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
