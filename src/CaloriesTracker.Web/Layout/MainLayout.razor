@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject AppState State
@inject IJSRuntime JS

<div class="app">
    <main class="content">
        @if (State.IsLoaded)
        {
            @Body
        }
        else
        {
            <p class="muted center">Chargement…</p>
        }
    </main>

    <nav class="tabbar">
        <NavLink href="" Match="NavLinkMatch.All" class="tab">
            <span class="tab-icon">◎</span><span>Aujourd'hui</span>
        </NavLink>
        <NavLink href="ajouter" class="tab">
            <span class="tab-icon">＋</span><span>Ajouter</span>
        </NavLink>
        <NavLink href="poids" class="tab">
            <span class="tab-icon">⚖</span><span>Poids</span>
        </NavLink>
        <NavLink href="profil" class="tab">
            <span class="tab-icon">☰</span><span>Profil</span>
        </NavLink>
    </nav>
</div>

@code {
    private DotNetObjectReference<MainLayout>? _selfRef;

    protected override async Task OnInitializedAsync()
    {
        State.Changed += OnStateChanged;
        await State.LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Pull from the cloud each time the app comes back to the foreground (e.g. switching from the Mac to the iPhone).
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("calories.onVisible", _selfRef);
        }
    }

    [JSInvokable]
    public Task OnVisible() => State.SyncAsync();

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        _selfRef?.Dispose();
        await ValueTask.CompletedTask;
    }
}
