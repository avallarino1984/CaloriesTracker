@page "/ajouter"
@inject AppState State
@inject NavigationManager Nav
@inject FoodCatalogService Foods

<PageTitle>Ajouter · Calories</PageTitle>

<h1>Ajouter un repas</h1>

@if (_catalog is not null && (_catalog.Favorites.Count > 0 || _catalog.Foods.Count > 0))
{
    <section class="card">
        <h2>Favoris</h2>
        <p class="muted small">Valeurs exactes des étiquettes (aliments.json).</p>
        <div class="chips">
            @foreach (var fav in _catalog.Favorites)
            {
                <button class="chip @(_selFavorite == fav ? "on" : "")" @onclick="() => Select(fav)">★ @fav.Name</button>
            }
            @foreach (var food in _catalog.Foods)
            {
                <button class="chip @(_selFood == food ? "on" : "")" @onclick="() => Select(food)">@food.Name</button>
            }
        </div>

        @if (Selected is { } values)
        {
            <div class="fav-detail">
                <p class="small">@SelectedLabel</p>
                <div class="row-between">
                    <div class="stepper">
                        <button class="icon-btn" disabled="@(_qty <= 0.5)" @onclick="() => _qty -= 0.5" aria-label="Moins">−</button>
                        <strong>× @_qty.ToString("0.#", Fmt.Fr)</strong>
                        <button class="icon-btn" @onclick="() => _qty += 0.5" aria-label="Plus">+</button>
                    </div>
                    <select class="type-select" @bind="_favType">
                        @foreach (var t in Enum.GetValues<MealType>())
                        {
                            <option value="@t">@Fmt.MealLabel(t)</option>
                        }
                    </select>
                </div>
                <p class="small">
                    <strong>@Fmt.Kcal(values.Kcal) kcal</strong>
                    · P @Fmt.Grams(values.ProteinG) · G @Fmt.Grams(values.CarbsG) · L @Fmt.Grams(values.FatG)
                </p>
                <button class="btn primary full" @onclick="SaveFavorite">Ajouter</button>
            </div>
        }
    </section>
}
@if (Foods.Error is { } catalogError)
{
    <p class="err small">@catalogError</p>
}

<section class="card">
    <h2>Coller depuis Claude</h2>
    <p class="muted small">Colle la réponse complète ou seulement les lignes <code>MEAL|…</code>. Plusieurs lignes à la fois, c'est correct.</p>
    <textarea rows="5" placeholder="MEAL|2026-10-17|dejeuner|Rôties, oeufs, café|400|20|40|18"
              @bind="_pasted" @bind:event="oninput" @bind:after="Parse"></textarea>

    @if (_results.Count > 0)
    {
        <ul class="preview">
            @foreach (var r in _results)
            {
                @if (r.Meal is { } m)
                {
                    <li class="ok">
                        <span>@Fmt.Day(m.Date) · @Fmt.MealLabel(m.Type) — @m.Description</span>
                        <strong>@Fmt.Kcal(m.Kcal) kcal</strong>
                    </li>
                }
                else
                {
                    <li class="err">Ligne @r.LineNumber : @r.Error</li>
                }
            }
        </ul>
        <button class="btn primary full" disabled="@(ValidMeals.Count == 0)" @onclick="SavePasted">
            Ajouter @ValidMeals.Count repas
        </button>
    }
    else if (!string.IsNullOrWhiteSpace(_pasted))
    {
        <p class="err">Aucune ligne MEAL trouvée.</p>
    }
</section>

<section class="card">
    <h2>Saisie manuelle</h2>
    <label>Date<input type="date" @bind="_manual.Date" /></label>
    <label>Repas
        <select @bind="_manual.Type">
            @foreach (var t in Enum.GetValues<MealType>())
            {
                <option value="@t">@Fmt.MealLabel(t)</option>
            }
        </select>
    </label>
    <label>Description<input type="text" @bind="_manual.Description" placeholder="Poulet, riz, haricots" /></label>
    <div class="grid4">
        <label>kcal<input type="number" inputmode="decimal" min="0" @bind="_manual.Kcal" /></label>
        <label>Prot. g<input type="number" inputmode="decimal" min="0" @bind="_manual.ProteinG" /></label>
        <label>Gluc. g<input type="number" inputmode="decimal" min="0" @bind="_manual.CarbsG" /></label>
        <label>Lip. g<input type="number" inputmode="decimal" min="0" @bind="_manual.FatG" /></label>
    </div>
    <button class="btn full" disabled="@(_manual.Kcal <= 0)" @onclick="SaveManual">Ajouter</button>
</section>

@code {
    private FoodCatalog? _catalog;
    private Favorite? _selFavorite;
    private Food? _selFood;
    private double _qty = 1;
    private MealType _favType = GuessMealType();

    protected override async Task OnInitializedAsync() => _catalog = await Foods.GetAsync();

    private void Select(Favorite favorite)
    {
        _selFavorite = favorite;
        _selFood = null;
        _qty = 1;
    }

    private void Select(Food food)
    {
        _selFood = food;
        _selFavorite = null;
        _qty = 1;
    }

    // Nutrition of the current selection times the chosen quantity, or null if nothing is selected.
    private NutritionValues? Selected =>
        _selFavorite is { } fav ? _catalog!.For(fav, _qty)
        : _selFood is { } food ? FoodCatalog.For(food, _qty)
        : null;

    private string SelectedLabel =>
        _selFood is { } food ? $"{food.Name} — {_qty.ToString("0.#", Fmt.Fr)} × {food.Portion}"
        : _selFavorite is { } fav ? (_qty == 1 ? fav.Name : $"{fav.Name} × {_qty.ToString("0.#", Fmt.Fr)}")
        : "";

    private async Task SaveFavorite()
    {
        if (Selected is not { } values)
        {
            return;
        }
        await State.AddMealsAsync([FoodCatalog.ToMeal(SelectedLabel, values, AppState.Today, _favType)]);
        Nav.NavigateTo("");
    }

    private string? _pasted;
    private List<MealParseResult> _results = [];
    private Meal _manual = NewManual();

    private List<Meal> ValidMeals => _results.Where(r => r.Meal is not null).Select(r => r.Meal!).ToList();

    private static Meal NewManual() => new() { Date = AppState.Today, Type = GuessMealType() };

    // Pre-select the meal slot from the time of day.
    private static MealType GuessMealType()
    {
        int hour = DateTime.Now.Hour;
        if (hour < 11) return MealType.Dejeuner;
        if (hour < 15) return MealType.Diner;
        if (hour >= 17 && hour < 21) return MealType.Souper;
        return MealType.Collation;
    }

    private void Parse() => _results = MealLineParser.ParseMany(_pasted).ToList();

    private async Task SavePasted()
    {
        await State.AddMealsAsync(ValidMeals);
        Nav.NavigateTo("");
    }

    private async Task SaveManual()
    {
        if (string.IsNullOrWhiteSpace(_manual.Description))
        {
            _manual.Description = Fmt.MealLabel(_manual.Type);
        }
        await State.AddMealsAsync([_manual]);
        _manual = NewManual();
        Nav.NavigateTo("");
    }
}
